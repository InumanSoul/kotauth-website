---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, type Locale, defaultLocale } from '@/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const i18n = t(locale);

const GITHUB_URL = 'https://github.com/inumansoul/kotauth';

const columns = [
  {
    status: 'Disponible',
    description: 'Disponible hoy en la v1.20.1.',
    legendDot: 'bg-[#1F9D55]',
    badgeWrap: 'bg-[#EAF7EF] border border-[#CDEBD9]',
    badgeDot: 'bg-[#1F9D55]',
    badgeText: 'text-[#1F8A4C]',
    cardClass: 'bg-white border border-kotauth-surface-2 shadow-[0_1px_3px_rgba(15,22,41,0.04)]',
    titleClass: 'text-kotauth-text-primary',
    bodyClass: 'text-kotauth-text-secondary',
    items: [
      { title: 'Núcleo de OAuth 2.0 y OIDC', body: 'Proveedor completo con PKCE, rotación de tokens y discovery.' },
      { title: 'Workspaces multi-tenant', body: 'Directorios, claves y políticas aislados por tenant.' },
      { title: 'Servidor MCP nativo de IA', body: '33 herramientas con alcance en 8 dominios.' },
      { title: 'Pantallas de autenticación white-label', body: 'Renderizadas en el servidor y con tema por workspace.' },
      { title: 'Magic-link y Email OTP', body: 'Flujos sin contraseña que se mantienen compatibles con MFA.' },
      { title: 'Copia de seguridad y restauración cifradas', body: 'Instantáneas de tenant portátiles mediante CLI o API.' },
      { title: 'Passkeys y WebAuthn', body: 'Inicio de sesión sin contraseña resistente al phishing mediante biometría o llaves de hardware.' },
      { title: 'Suplantación de administrador', body: 'Sesiones de soporte con alcance y totalmente auditadas con claim act de RFC 8693.' },
    ],
  },
  {
    status: 'En curso',
    description: 'En desarrollo activo para próximas versiones.',
    legendDot: 'bg-kotauth-primary',
    badgeWrap: 'bg-[#EAF6FB] border border-[#CDE8F5]',
    badgeDot: 'bg-kotauth-primary',
    badgeText: 'text-kotauth-primary',
    cardClass: 'bg-white border border-kotauth-surface-2 border-l-[3px] border-l-kotauth-primary shadow-[0_1px_3px_rgba(15,22,41,0.04)]',
    titleClass: 'text-kotauth-text-primary',
    bodyClass: 'text-kotauth-text-secondary',
    items: [
      { title: 'SSO empresarial', body: 'Federación con LDAP y SAML para proveedores de identidad upstream.' },
      { title: 'Streaming de eventos por webhook', body: 'Suscribe sistemas downstream a eventos de auditoría y de ciclo de vida.' },
    ],
  },
  {
    status: 'Planificado',
    description: 'Comprometido, definido y en cola.',
    legendDot: 'bg-[#D9890E]',
    badgeWrap: 'bg-[#FBF1E2] border border-[#F0DCBC]',
    badgeDot: 'bg-[#D9890E]',
    badgeText: 'text-[#B5730C]',
    cardClass: 'bg-white border border-kotauth-surface-2 shadow-[0_1px_3px_rgba(15,22,41,0.04)]',
    titleClass: 'text-kotauth-text-primary',
    bodyClass: 'text-kotauth-text-secondary',
    items: [
      { title: 'Aprovisionamiento SCIM', body: 'Sincronización automatizada del ciclo de vida del usuario con directorios externos.' },
      { title: 'Autorización granular', body: 'Control de acceso basado en relaciones para permisos complejos.' },
      { title: 'Gestión de organizaciones autoservicio', body: 'Permite a los usuarios finales crear y administrar sus propias organizaciones.' },
      { title: 'Exportación del registro de auditoría', body: 'Envío programado a destinos SIEM y almacenamiento de objetos.' },
    ],
  },
  {
    status: 'En exploración',
    description: 'En investigación. Dinos si las necesitas.',
    legendDot: 'bg-[#A6AEBA]',
    badgeWrap: 'bg-[#F2F3F5] border border-kotauth-surface-2',
    badgeDot: 'bg-[#A6AEBA]',
    badgeText: 'text-[#7A8694]',
    cardClass: 'bg-[#FBFBFC] border border-dashed border-[#D8DCE3]',
    titleClass: 'text-kotauth-text-secondary',
    bodyClass: 'text-kotauth-text-muted',
    items: [
      { title: 'Flujo de autorización de dispositivos', body: 'Inicia sesión en dispositivos con entrada limitada como televisores y CLIs.' },
      { title: 'Autenticación step-up', body: 'Exige factores más fuertes para operaciones sensibles.' },
      { title: 'Políticas como código', body: 'Políticas de seguridad versionadas y aplicadas en el momento del despliegue.' },
      { title: 'Hooks de facturación por organización', body: 'Señales de uso para equipos que construyen productos sobre Kotauth.' },
    ],
  },
];
---

<BaseLayout
  title={i18n.pages.roadmap.title}
  description={i18n.pages.roadmap.description}
  path="/roadmap"
>
  <!-- Page header -->
  <section class="relative px-7 pt-32 pb-14 text-center overflow-hidden">
    <div
      class="absolute -top-[120px] left-1/2 -translate-x-1/2 w-[900px] h-[420px] pointer-events-none"
      style="background:radial-gradient(ellipse at center,rgba(0,119,168,.1),transparent 70%);"
    ></div>
    <div class="relative max-w-[720px] mx-auto">
      <span class="eyebrow">Hoja de ruta</span>
      <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-[54px] leading-[1.06] tracking-[-0.03em] text-kotauth-text-primary mt-[14px] mb-[18px]">
        Lo que estamos construyendo a continuación
      </h1>
      <p class="text-lg leading-[1.6] text-kotauth-text-secondary font-medium">
        Kotauth es de código abierto y se construye de forma abierta. Aquí está el estado actual y hacia dónde se dirige. Las prioridades cambian con los aportes de la comunidad.
      </p>
    </div>
  </section>

  <!-- Status legend -->
  <section class="max-w-[920px] mx-auto px-7 pb-10">
    <div class="flex flex-wrap justify-center gap-x-[22px] gap-y-3 text-[13px] font-semibold text-kotauth-text-secondary">
      {columns.map((col) => (
        <span class="inline-flex items-center gap-[7px]">
          <span class={`w-[9px] h-[9px] inline-block ${col.legendDot}`}></span>
          {col.status}
        </span>
      ))}
    </div>
  </section>

  <!-- Timeline -->
  <section class="max-w-[920px] mx-auto px-7 pb-20">
    {columns.map((col, i) => (
      <div
        class={`grid grid-cols-1 md:grid-cols-[200px_1fr] gap-8 py-[34px] border-t border-kotauth-surface-2 ${i === columns.length - 1 ? 'border-b' : ''}`}
      >
        <div>
          <div class={`inline-flex items-center gap-2 px-[11px] py-[5px] mb-2 ${col.badgeWrap}`}>
            <span class={`w-2 h-2 inline-block ${col.badgeDot}`}></span>
            <span class={`text-[12.5px] font-bold ${col.badgeText}`}>{col.status}</span>
          </div>
          <p class="text-[13px] text-kotauth-text-muted leading-[1.5]">{col.description}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-[14px]">
          {col.items.map((item) => (
            <div class={`px-5 py-[18px] ${col.cardClass}`}>
              <h3 class={`font-heading text-[15px] font-bold mb-1 ${col.titleClass}`}>{item.title}</h3>
              <p class={`text-[13px] leading-[1.5] ${col.bodyClass}`}>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Shape it -->
  <section class="max-w-[920px] mx-auto px-7 pb-28">
    <div class="bg-kotauth-bg-secondary border border-kotauth-surface-2 px-10 py-11 text-center">
      <h2 class="font-heading font-bold text-[28px] tracking-[-0.02em] text-kotauth-text-primary mb-[10px]">Opina sobre lo que viene después</h2>
      <p class="text-base leading-[1.6] text-kotauth-text-secondary font-medium max-w-[480px] mx-auto mb-6">
        Las prioridades de la hoja de ruta se definen en público. Abre una discusión, envía una solicitud o vota por lo que más te importa.
      </p>
      <div class="flex flex-wrap justify-center gap-[13px]">
        <a
          href={`${GITHUB_URL}/discussions`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-kotauth-primary hover:bg-kotauth-primary-light text-white px-[22px] h-12 text-[14.5px] font-semibold transition-colors"
        >
          Unirse a la discusión
        </a>
        <a
          href={`${GITHUB_URL}/issues/new`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white border border-kotauth-surface-2 text-kotauth-text-primary hover:border-kotauth-primary/40 px-[22px] h-12 text-[14.5px] font-semibold transition-colors"
        >
          Solicitar una función
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
