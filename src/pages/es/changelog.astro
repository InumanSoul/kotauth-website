---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, formatDate, type Locale, defaultLocale } from '@/i18n';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const i18n = t(locale);

const GITHUB_URL = 'https://github.com/inumansoul/kotauth';

type Tag = 'Added' | 'Improved' | 'Changed' | 'Fixed' | 'Security';
type ChangeItem = { tag: Tag; text: string };
type Release = { version: string; date: string; current?: boolean; items: ChangeItem[] };

const releases: Release[] = [
  {
    version: '1.31.0',
    date: 'November 24, 2026',
    current: true,
    items: [
      { tag: 'Added', text: 'Un dominio público por workspace: las pantallas de inicio de sesión, el issuer y los enlaces por email pasan al origen propio del workspace. Las passkeys siguen funcionando mediante related origins de WebAuthn; la suplantación se queda en la dirección de la instancia' },
      { tag: 'Added', text: 'Las copias de seguridad incluyen el sub de cada usuario, así un workspace movido a otra instancia conserva los identificadores que guardaron sus clientes' },
      { tag: 'Added', text: 'Direcciones de cliente correctas detrás de una CDN y un reverse proxy con KAUTH_TRUSTED_PROXY_CIDRS y KAUTH_CLIENT_IP_HEADER' },
      { tag: 'Changed', text: 'BREAKING: Los usuarios nuevos reciben un UUID aleatorio como sub en lugar del id de fila de la base de datos. Los existentes conservan el suyo; guarda sub como texto' },
      { tag: 'Fixed', text: 'Discovery anuncia el mismo issuer que llevan los tokens' },
    ],
  },
  {
    version: '1.30.2',
    date: 'November 24, 2026',
    items: [
      { tag: 'Security', text: 'Un webhook se conecta solo a la dirección que pasó la verificación SSRF, cerrando un hueco de DNS rebinding' },
      { tag: 'Fixed', text: 'El inicio de sesión con código por email puede pedir scopes de API; un nombre de usuario ya no puede coincidir con el email de otro usuario, ni con escrituras concurrentes' },
    ],
  },
  {
    version: '1.30.1',
    date: 'November 24, 2026',
    items: [
      { tag: 'Security', text: 'BREAKING: Los webhooks ya no pueden alcanzar direcciones privadas, loopback o de metadatos. Usa KAUTH_WEBHOOK_ALLOW_PRIVATE_NETWORKS=true para receptores internos' },
      { tag: 'Security', text: 'Quitar una clave de KAUTH_BOOTSTRAP_API_KEYS ahora la revoca' },
      { tag: 'Added', text: 'POST /users/{userId}/resend-invite en la API de administración' },
      { tag: 'Fixed', text: 'Un usuario invitado que restablece su contraseña en lugar de aceptar la invitación puede iniciar sesión; los ID tokens vuelven a dirigirse al cliente cuando la app tiene audience' },
    ],
  },
  {
    version: '1.30.0',
    date: 'November 24, 2026',
    items: [
      { tag: 'Added', text: 'Los tokens incluyen amr y acr, y los clientes pueden exigir multifactor por solicitud con acr_values (autenticación step-up)' },
      { tag: 'Added', text: 'Los usuarios reciben un email cuando cambian sus factores de inicio de sesión' },
      { tag: 'Changed', text: 'Un workspace que exige MFA hace que los usuarios lo configuren durante el inicio de sesión en lugar de rechazarlos' },
      { tag: 'Security', text: 'Un refresh token solo funciona en su propio workspace y para su propio cliente habilitado' },
    ],
  },
  {
    version: '1.29.0',
    date: 'November 23, 2026',
    items: [
      { tag: 'Added', text: 'La API REST puede leer y definir los scopes permitidos de un cliente en un resource server' },
      { tag: 'Security', text: 'BREAKING: La API de código por email pide el segundo factor: POST /auth/verify-otp responde mfa_required para usuarios con MFA, y se completa con POST /auth/verify-mfa' },
      { tag: 'Security', text: 'El inicio de sesión social ya no abre una sesión antes del segundo factor; cerrar sesión en todas partes termina todas las sesiones en Redis' },
      { tag: 'Fixed', text: 'El ajuste de sesiones concurrentes máximas ahora funciona, por aplicación' },
    ],
  },
  {
    version: '1.28.1',
    date: 'November 20, 2026',
    items: [
      { tag: 'Security', text: 'Todas las vías de inicio de sesión piden ahora el segundo factor: magic link, código por email, social y passkeys sin verificación de usuario, no solo contraseña' },
    ],
  },
  {
    version: '1.28.0',
    date: 'November 20, 2026',
    items: [
      { tag: 'Added', text: 'Duración del access token por aplicación, expiración del magic link y ajustes de registro y bloqueo por código por email en la consola' },
      { tag: 'Improved', text: 'La consola de administración funciona con teclado y lector de pantalla, y usa un vocabulario coherente en todos los flujos de creación' },
      { tag: 'Security', text: 'El inicio de sesión con código por email ya no distingue una dirección conocida de una desconocida por el tiempo de respuesta' },
      { tag: 'Fixed', text: '"Iniciar sesión con una passkey" funciona en navegadores con autocompletado de passkeys; los filtros SCIM ignoran mayúsculas donde el esquema lo indica' },
    ],
  },
  {
    version: '1.27.0',
    date: 'November 17, 2026',
    items: [
      { tag: 'Added', text: 'Crea un workspace por API con POST /admin/api/v1/tenants y cambia sus ajustes con PATCH /t/{slug}/api/v1/workspace' },
      { tag: 'Added', text: 'Una clave de API de bootstrap puede esperar a que se cree su workspace' },
      { tag: 'Security', text: 'GET /authorize rechaza de entrada un cliente o redirect URI inválido en lugar de mostrar la pantalla de inicio de sesión' },
      { tag: 'Fixed', text: 'DB_HOST, DB_PORT y DB_NAME ahora se leen; un workspace importado emite tokens sin reiniciar' },
    ],
  },
  {
    version: '1.26.0',
    date: 'September 10, 2026',
    items: [
      { tag: 'Fixed', text: 'Un workspace restaurado conserva toda su configuración: resource servers, ajustes de proveedores de identidad, audiences de aplicación y accesos del launcher' },
      { tag: 'Fixed', text: 'Las copias anteriores a 1.24 vuelven a restaurarse: los nombres de usuario heredados se reescriben con las reglas actuales' },
      { tag: 'Fixed', text: 'Importar un workspace desde la consola queda registrado en el log de auditoría' },
    ],
  },
  {
    version: '1.25.3',
    date: 'September 9, 2026',
    items: [
      { tag: 'Fixed', text: 'Un POST bajo un workspace redirige a la pantalla de inicio de sesión en lugar de devolver 500; los cuerpos de backup mal formados informan el error de parseo' },
      { tag: 'Improved', text: '1.25.1–1.25.3 también traen títulos y breadcrumbs coherentes en la administración, y una CI que aplica cada migración a una base de datos real' },
    ],
  },
  {
    version: '1.25.0',
    date: 'September 8, 2026',
    items: [
      { tag: 'Security', text: 'Autorizar un cliente contra una API ya no le concede todos los scopes que declara; cada cliente tiene una allowlist explícita de scopes' },
      { tag: 'Added', text: 'Casillas por scope en la página de APIs autorizadas' },
      { tag: 'Changed', text: 'Añadir un scope a una API no lo concede a los clientes existentes; los permisos existentes se migran al actualizar' },
    ],
  },
  {
    version: '1.24.0',
    date: 'September 4, 2026',
    items: [
      { tag: 'Added', text: 'Modo de identificador de inicio de sesión por workspace: USERNAME, EMAIL o EITHER. El formulario de login se adapta al modo elegido' },
      { tag: 'Added', text: 'Nombres de usuario autogenerados para usuarios aprovisionados sin uno (creación admin, invitación, JIT). Nombres de usuario editables por el admin con detección de colisiones' },
      { tag: 'Security', text: 'Normalización de nombres de usuario aplicada en todas las rutas de creación y renombrado. Prevención de colisiones entre namespaces rechaza un username que coincida con el email de otro usuario y viceversa' },
      { tag: 'Fixed', text: 'Los renombrados de username por admin ahora persisten en Postgres — la consulta de actualización nunca escribía la columna username, por lo que los renombrados silenciosamente no tenían efecto' },
    ],
  },
  {
    version: '1.23.0',
    date: 'September 3, 2026',
    items: [
      { tag: 'Added', text: 'Brokering de identidad OIDC genérico: inicia sesión de usuarios a través de cualquier proveedor OpenID Connect. Validación estricta del emisor, PKCE del lado RP, resolución de endpoints por discovery y diagnósticos por proveedor' },
      { tag: 'Added', text: 'Aprovisionamiento just-in-time de usuarios para proveedores con brokering con listas de dominios permitidos por proveedor' },
      { tag: 'Added', text: 'Aprovisionamiento SCIM 2.0: endpoints de Users y Groups RFC 7644 con filtrado, paginación, PATCH y dialectos por conector para Entra ID / Okta' },
      { tag: 'Changed', text: 'BREAKING: Eliminar un grupo con subgrupos ahora retorna 409 Conflict en lugar de eliminar en cascada. Los clientes deben eliminar o reasignar los subgrupos primero' },
      { tag: 'Security', text: 'Estado de login con brokering vinculado a cookie del navegador; cookies de social login y desafío MFA con scope de workspace; corrección de consumo cross-workspace de magic-link' },
    ],
  },
  {
    version: '1.22.0',
    date: 'August 21, 2026',
    items: [
      { tag: 'Added', text: 'Tipos de grant explícitos por aplicación: authorization_code, client_credentials, refresh_token. El endpoint de tokens rechaza cualquier grant para el que el cliente no esté registrado' },
      { tag: 'Added', text: 'Client secret emitido al crear aplicaciones confidenciales. Redirect URI ahora requerido solo cuando la aplicación usa authorization_code' },
      { tag: 'Changed', text: 'BREAKING: Los clientes bearer-only se retroalimentan sin grants y son rechazados en el endpoint de tokens tras la actualización. Los consumidores de API que crean clientes M2M deben ahora enviar grantTypes explícitamente' },
      { tag: 'Fixed', text: 'El grant authorization_code ahora verifica que el código fue emitido para el cliente que lo presenta (RFC 6749 §4.1.3)' },
    ],
  },
  {
    version: '1.21.0',
    date: 'July 17, 2026',
    items: [
      { tag: 'Added', text: '25 nuevos endpoints REST API para usuarios, aplicaciones, sesiones, workspace, webhooks, servidores de recursos, claves API y passkeys. Siete nuevos scopes para acceso granular por clave API' },
      { tag: 'Added', text: 'Layout SPLIT de login: panel izquierdo con marca, imagen de fondo y tagline junto a la tarjeta de autenticación' },
      { tag: 'Added', text: 'Rate limiting por clave y por tenant en endpoints de escritura (60 req/60s). Especificación OpenAPI actualizada a 1.1.0' },
      { tag: 'Changed', text: 'BREAKING: DELETE /api/v1/applications ahora hace soft-delete (is_deleted) en lugar de soft-disable (enabled = false). Re-crear un client_id eliminado retorna 409' },
    ],
  },
  {
    version: '1.20.1',
    date: 'July 10, 2026',
    items: [
      { tag: 'Changed', text: 'La cuadrícula de métodos de inicio de sesión reemplaza el panel de dos tarjetas en la página de política de seguridad: una fila por método (Contraseña, Passkey, Magic link, Email OTP, Google, GitHub)' },
      { tag: 'Changed', text: 'password_login_disabled consolidado en security_config.passwordLoginEnabled (la migración V55 rellena automáticamente)' },
      { tag: 'Changed', text: 'El rail de Seguridad del panel de administración se reestructuró: Política de seguridad, MFA, Passkeys, Sesiones. El portal gana un grupo padre de Seguridad' },
      { tag: 'Fixed', text: 'La página de cambio de contraseña ahora activa correctamente el grupo de navegación de Seguridad' },
    ],
  },
  {
    version: '1.20.0',
    date: 'July 9, 2026',
    items: [
      { tag: 'Added', text: 'Passkeys / WebAuthn: inicio de sesión sin contraseña mediante biometría del dispositivo (Face ID, Windows Hello) o llaves de hardware (YubiKey). Se registran en el portal y se inicia sesión con un toque o autocompletado condicional' },
      { tag: 'Added', text: 'Toggle de passkeys_enabled por tenant y modo solo-sin-contraseña (oculta el campo de contraseña, muestra solo passkey + magic link)' },
      { tag: 'Added', text: 'Gestión de passkeys por usuario desde admin: listar credenciales con nombres de dispositivo (búsqueda AAGUID), revocar individualmente, restablecer todas. Nuevo comando CLI reset-admin-passkeys' },
      { tag: 'Security', text: 'Passkey con verificación de usuario satisface MFA: los usuarios omiten TOTP al iniciar sesión con una passkey' },
      { tag: 'Security', text: 'Defensa contra repetición por credencial mediante el contador de firma WebAuthn; los autenticadores clonados se revocan automáticamente con evento de auditoría PASSKEY_REPLAY_REJECTED' },
      { tag: 'Security', text: 'Puerta dura de SMTP impide habilitar el modo solo-sin-contraseña sin la entrega de email configurada' },
      { tag: 'Security', text: 'Rate limiting en el endpoint de autenticación por passkey: 10 intentos por 60s por IP, fail-closed en caída de Redis' },
    ],
  },
  {
    version: '1.19.3',
    date: 'June 29, 2026',
    items: [
      { tag: 'Added', text: 'Indicador de recurso RFC 8707 en el grant authorization_code: los parámetros de recurso se vinculan al código emitido y se propagan al claim aud del access token' },
      { tag: 'Added', text: 'Estrechamiento de alcance RFC 9068: las solicitudes de token que apuntan a APIs se estrechan a la intersección de los scopes solicitados y los scopes declarados de las APIs' },
      { tag: 'Added', text: 'Editor de scopes en el Admin UI: cada API en el registro del workspace puede declarar sus scopes aceptados, mostrados como badges en línea' },
      { tag: 'Changed', text: 'La página de Brand Identity del admin se reestructuró en tarjeta de Brand Identity + tarjeta de Visual Theme' },
      { tag: 'Changed', text: 'Dependencias actualizadas: JUnit 6.1.0, Exposed 1.3.0, imagen base JRE 25' },
    ],
  },
  {
    version: '1.19.2',
    date: 'June 22, 2026',
    items: [
      { tag: 'Changed', text: 'Dos archivos compose en la raíz (docker-compose.yml + docker-compose.prod.yml) reemplazan a los seis que vivían en docker/' },
      { tag: 'Changed', text: 'El overlay de DB externa se reemplaza por DB_URL en .env; el overlay de demo se reemplaza por KAUTH_DEMO_MODE=true en .env' },
      { tag: 'Improved', text: 'Toda la guía de despliegue se movió a la documentación; se eliminaron los comentarios del Dockerfile, el Caddyfile y los archivos compose' },
    ],
  },
  {
    version: '1.19.1',
    date: 'June 22, 2026',
    items: [
      { tag: 'Added', text: 'Inyección de secretos basada en archivos (convención *_FILE) para KAUTH_SECRET_KEY, DB_PASSWORD, KAUTH_REDIS_PASSWORD, KAUTH_BOOTSTRAP_ADMIN_PASSWORD y KAUTH_BOOTSTRAP_API_KEYS' },
      { tag: 'Added', text: 'Bloqueo de dependencias de Gradle: gradle.lockfile fija el grafo de dependencias resuelto y CI lo verifica en cada PR' },
      { tag: 'Added', text: 'Dependabot habilitado para alertas semanales sobre dependencias de Gradle, GitHub Actions e imágenes base de Docker' },
    ],
  },
  {
    version: '1.19.0',
    date: 'June 19, 2026',
    items: [
      { tag: 'Security', text: 'Cadena HMAC sobre el registro de auditoría: cada fila lleva prev_hash y row_hash mediante HMAC-SHA256 con clave KAUTH_SECRET_KEY; cualquier manipulación o reordenamiento rompe la cadena' },
      { tag: 'Added', text: 'El nuevo comando CLI verify-audit-chain detecta filas de auditoría manipuladas o reordenadas' },
      { tag: 'Fixed', text: 'Los detalles del registro de auditoría ahora usan kotlinx.serialization, corrigiendo la corrupción silenciosa de JSON por cadenas concatenadas a mano' },
      { tag: 'Fixed', text: 'Introspección de tokens multi-audiencia: AccessTokenClaims.aud se amplió para admitir el formato de array' },
    ],
  },
  {
    version: '1.18.0',
    date: 'June 17, 2026',
    items: [
      { tag: 'Added', text: 'Resource Indicators de RFC 8707 para el grant client_credentials: tokens M2M dirigidos por audiencia con aud vinculado al recurso solicitado' },
      { tag: 'Added', text: 'Registro de APIs (admin: /settings/apis): CRUD con alcance de workspace para identificadores de audiencia' },
      { tag: 'Added', text: 'Pantalla "Authorized APIs" por cliente con autorización mediante casillas y metadatos de Discovery que anuncian resource_indicators_supported: true' },
      { tag: 'Security', text: 'Los recursos desconocidos o no autorizados devuelven RFC 8707 invalid_target 400 en lugar de un token silenciosamente amplio' },
    ],
  },
  {
    version: '1.17.0',
    date: 'June 17, 2026',
    items: [
      { tag: 'Added', text: 'Los 8 tipos de email transaccional ahora están localizados: verificación, magic link, restablecimiento de contraseña, cuenta bloqueada, invitación, contraseña cambiada, prueba de SMTP y OTP' },
      { tag: 'Added', text: 'Las plantillas de email se renderizan en el defaultLocale del workspace con fallback al inglés por clave' },
      { tag: 'Security', text: 'Proxy de confianza opcional (KAUTH_TRUSTED_PROXY): evita eludir el rate limiting mediante spoofing de cabeceras' },
      { tag: 'Security', text: 'Validación del issuer de JWT: los tokens emitidos por un tenant son rechazados por otro' },
      { tag: 'Security', text: 'Prevención de open redirect: el redirect_uri posterior al login se valida contra los valores registrados' },
      { tag: 'Security', text: 'La comparación del code verifier de PKCE S256 usa igualdad de tiempo constante' },
      { tag: 'Security', text: 'La cabecera Server se suprime de las respuestas HTTP' },
      { tag: 'Security', text: 'La normalización de errores de login con igualación de tiempos previene la enumeración de usuarios' },
    ],
  },
  {
    version: '1.16.0',
    date: 'June 17, 2026',
    items: [
      { tag: 'Security', text: 'El contenedor se ejecuta como non-root (UID 10001) con no-new-privileges, cap_drop: ALL y sistema de archivos de solo lectura' },
      { tag: 'Security', text: 'Protección contra replay de TOTP: cada código es de un solo uso por enrolamiento; bloqueo tras un número configurable de intentos fallidos' },
      { tag: 'Fixed', text: 'La validación de variables CSS del tema evita la inyección de valores arbitrarios a través de la configuración del workspace' },
      { tag: 'Improved', text: 'Tiempos de error de login igualados en las rutas de verificación de contraseña y de TOTP' },
    ],
  },
  {
    version: '1.15.0',
    date: 'June 15, 2026',
    items: [
      { tag: 'Changed', text: 'AdminService se dividió en AuthManagementService, UserAdminService y WorkspaceAdminService' },
      { tag: 'Changed', text: 'UserSelfServiceService se dividió en UserProfileService y UserSecurityService' },
      { tag: 'Improved', text: 'Se endureció el ratchet de Detekt: reglas de complejidad y acoplamiento aplicadas en CI' },
    ],
  },
  {
    version: '1.14.1',
    date: 'June 12, 2026',
    items: [
      { tag: 'Security', text: 'BREAKING: Se eliminó la credencial de admin por defecto. Se genera una contraseña aleatoria en el primer arranque y se registra una sola vez en stdout.' },
    ],
  },
  {
    version: '1.14.0',
    date: 'June 11, 2026',
    items: [
      { tag: 'Security', text: 'BREAKING: El endpoint de refresh token ahora requiere autenticación de cliente (client_id + client_secret para clientes confidenciales)' },
      { tag: 'Security', text: 'BREAKING: Los endpoints de introspección y revocación requieren autenticación de cliente según RFC 7662 / RFC 7009' },
      { tag: 'Added', text: 'Detección de replay de refresh token con revocación completa de la familia de sesiones al reutilizarse' },
      { tag: 'Added', text: 'Bloqueo de cuenta con umbral configurable e interfaz de desbloqueo para administradores' },
    ],
  },
  {
    version: '1.13.0',
    date: 'May 26, 2026',
    items: [
      { tag: 'Added', text: 'Login con Email OTP alojado: autenticación passwordless de dos pasos en el navegador (ingresa el email, recibe un código de 6 dígitos, inicia sesión)' },
      { tag: 'Added', text: 'Conmutador por tenant para Email OTP desde la configuración del workspace' },
      { tag: 'Added', text: 'Primitivas de API de administración send-otp / verify-otp para onboarding passwordless programático' },
      { tag: 'Security', text: 'Defensa de bloqueo entre desafíos: umbral de intentos de OTP por tenant con respuesta de tiempo constante' },
    ],
  },
  {
    version: '1.12.1',
    date: 'May 26, 2026',
    items: [
      { tag: 'Fixed', text: 'Desajuste del prefijo de las API keys bootstrap: kauth_{slug}_ ahora se aplica de forma consistente en la generación y la validación' },
      { tag: 'Fixed', text: 'Validación de redirect URI más estricta: se requiere coincidencia exacta y se rechazan las variantes con barra final' },
      { tag: 'Improved', text: 'Especificación OpenAPI actualizada con los endpoints de envío/verificación de OTP y la documentación de filtros del registro de auditoría' },
      { tag: 'Improved', text: 'Los grupos de filtros del registro de auditoría se muestran en la interfaz de administración para una navegación más clara por categoría de evento' },
    ],
  },
  {
    version: '1.12.0',
    date: 'May 25, 2026',
    items: [
      { tag: 'Added', text: 'Roles por defecto del cliente: roles por aplicación asignados automáticamente a los usuarios que se autorregistran a través de una aplicación OAuth' },
      { tag: 'Added', text: 'Tarjeta de "Registration Defaults" en la consola de administración con menú desplegable y tabla de gestión de roles' },
      { tag: 'Added', text: 'Protección contra escalada de privilegios entre clientes: los roles de otras aplicaciones no pueden asignarse como predeterminados' },
    ],
  },
  {
    version: '1.11.0',
    date: 'May 23, 2026',
    items: [
      { tag: 'Added', text: 'Branding de emails transaccionales: nombre de marca, color, URL del logo, email de soporte y nombre de remitente por tenant' },
      { tag: 'Added', text: 'Las 8 plantillas de email transaccional heredan automáticamente el branding del workspace' },
      { tag: 'Added', text: 'Tarjeta de editor de branding en la configuración del workspace con vista previa en vivo' },
    ],
  },
  {
    version: '1.10.0',
    date: 'May 12, 2026',
    items: [
      { tag: 'Added', text: 'Impersonación de admin: actúa como cualquier usuario sin conocer su contraseña, con el claim act de RFC 8693 en el token de sesión' },
      { tag: 'Added', text: 'Modelo de doble sesión: la sesión del admin permanece activa por debajo de la sesión impersonada' },
      { tag: 'Security', text: 'Revocación en cascada: revocar la sesión del admin también termina la sesión impersonada' },
    ],
  },
  {
    version: '1.9.0',
    date: 'May 8, 2026',
    items: [
      { tag: 'Added', text: 'Servidor MCP nativo de IA (@kotauth/mcp): gestiona usuarios, roles, sesiones y registros de auditoría desde Claude, Cursor o cualquier cliente MCP vía Model Context Protocol' },
      { tag: 'Added', text: 'Control de acceso basado en alcances en cada herramienta MCP: la API key otorga solo los permisos que elijas' },
      { tag: 'Added', text: 'Conexión con un comando: npx @kotauth/mcp' },
    ],
  },
];

const tagColors: Record<string, string> = {
  Added: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  Improved: 'bg-kotauth-primary/5 text-kotauth-primary border-kotauth-primary/20',
  Changed: 'bg-slate-100 text-slate-500 border-slate-200',
  Fixed: 'bg-amber-50 text-amber-700 border-amber-200',
  Security: 'bg-red-50 text-red-700 border-red-200',
};

const tagLabels: Record<string, string> = {
  Added: 'Añadido',
  Improved: 'Mejorado',
  Changed: 'Cambiado',
  Fixed: 'Corregido',
  Security: 'Seguridad',
};
---

<BaseLayout
  title={i18n.pages.changelog.title}
  description={i18n.pages.changelog.description}
  path="/changelog"
>
  <!-- Header -->
  <section class="relative px-7 pt-32 pb-14 text-center overflow-hidden">
    <div
      class="absolute -top-[120px] left-1/2 -translate-x-1/2 w-[900px] h-[420px] max-w-full pointer-events-none"
      style="background:radial-gradient(ellipse at center,rgba(0,119,168,.1),transparent 70%);"
    ></div>
    <div class="relative max-w-[680px] mx-auto">
      <span class="eyebrow">Historial</span>
      <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-[54px] text-kotauth-text-primary leading-[1.06] tracking-[-0.03em] mt-3.5 mb-[18px]">
        Historial de versiones
      </h1>
      <p class="text-lg sm:text-[18.5px] text-kotauth-text-secondary leading-[1.6] max-w-[620px] mx-auto">
        Cada versión, con qué cambió y por qué. Kotauth sigue el versionado semántico.
      </p>
    </div>
  </section>

  <!-- Tag legend -->
  <section class="max-w-[880px] mx-auto px-7 pb-9">
    <div class="flex flex-wrap gap-3.5 justify-center">
      {Object.entries(tagColors).map(([tag, cls]) => (
        <span class={`inline-flex items-center font-mono text-[11px] font-semibold border px-[9px] py-[3px] ${cls}`}>{tagLabels[tag]}</span>
      ))}
    </div>
  </section>

  <!-- Releases -->
  <section class="max-w-[880px] mx-auto px-7 pb-24">
    {releases.map((rel) => (
      <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr] gap-5 sm:gap-8 py-8 border-t border-kotauth-surface-2">
        <div>
          <a
            href={`${GITHUB_URL}/releases/tag/v${rel.version}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-mono text-[15px] font-semibold text-kotauth-text-primary bg-white border border-kotauth-surface-2 px-[11px] py-[5px] mb-2 hover:text-kotauth-primary hover:border-kotauth-primary/40 transition-colors"
          >
            v{rel.version}
          </a>
          <div class="text-[13px] text-kotauth-text-muted">{formatDate(rel.date, locale)}</div>
          {rel.current && (
            <div class="inline-flex items-center gap-1.5 mt-2 text-[11.5px] font-semibold text-emerald-600">
              <span class="w-[7px] h-[7px] rounded-full bg-emerald-500"></span>Versión actual
            </div>
          )}
        </div>
        <div class="flex flex-col gap-[11px]">
          {rel.items.map((ch) => (
            <div class="flex gap-3 items-start">
              <span class={`flex-shrink-0 font-mono text-[10.5px] font-semibold border px-2 py-[3px] w-[72px] text-center ${tagColors[ch.tag]}`}>
                {tagLabels[ch.tag]}
              </span>
              <p class="text-[14.5px] text-kotauth-text-secondary leading-[1.55]">{ch.text}</p>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-10 pt-8 border-t border-kotauth-surface-2">
      <a
        href={`${GITHUB_URL}/releases`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-kotauth-primary hover:text-kotauth-primary-light transition-colors font-medium"
      >
        Ver todas las versiones en GitHub &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
